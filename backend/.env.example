# Application Settings
PROJECT_NAME="GHOST"
VERSION="0.1.0"
ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="console"

# Database Configuration (Placeholder for Phase 2)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="ghost_db"
POSTGRES_USER="ghost_user"
POSTGRES_PASSWORD="change_me_in_production"

# Redis Configuration (Placeholder for Phase 2/4)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# Security / JWT (Placeholder for Phase 3)
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
